{
  "name": "tipsy-promo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render TipsyReel out/tipsy-reel-th.mp4",
    "render:en": "remotion render TipsyReelEN out/tipsy-reel-en.mp4",
    "render:cover": "remotion still TipsyCover out/tipsy-cover.png --frame=60",
    "render:all": "pnpm render && pnpm render:en && pnpm render:cover",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.530",
    "@remotion/google-fonts": "^4.0.530",
    "@remotion/transitions": "^4.0.530",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.530"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
